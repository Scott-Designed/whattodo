{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "whattodo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-I",
        "-c",
        "import os,functools,http.server,socketserver;D=os.path.expanduser('~/.cache/notice-preview');H=functools.partial(http.server.SimpleHTTPRequestHandler,directory=D);socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('127.0.0.1',int(os.environ.get('PORT','4173'))),H).serve_forever()"
      ],
      "port": 4173,
      "autoPort": true
    }
  ]
}
