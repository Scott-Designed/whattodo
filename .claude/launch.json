{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "whattodo",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;os.chdir(os.path.join(os.path.dirname(os.path.abspath('.claude/launch.json')),'public') if os.path.isdir('public') else 'public');socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('127.0.0.1',4173),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "port": 4173
    }
  ]
}
