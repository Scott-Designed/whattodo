{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/place/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/type/:slug",
      "destination": "/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:slug",
      "destination": "/api/subject?slug=:slug"
    }
  ],
  "functions": {
    "api/subject.mjs": {
      "includeFiles": "public/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
